# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so only put PUBLIC values here (the Supabase anon key is designed to be public;
# Row Level Security protects your data). NEVER put the Anthropic key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
