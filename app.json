{
  "expo": {
    "name": "Runeterra Journal",
    "slug": "runeterra-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runeterrajournal",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080D",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runeterrajournal.app"
    },
    "android": {
      "package": "com.runeterrajournal.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07080D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
